# OBP-1™ Verification Authority
NODE_ENV=development
PORT=3000

# Required for all authority-changing operations.
# Generate a strong server-side secret. Never expose it in browser code.
OBP1_API_KEY=

# Durable single-node store for v0.2.
# Production deployment must mount this path on persistent storage.
OBP1_DATA_FILE=.data/obp1-store.json
